# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ig_tracker
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Instagram OAuth & API
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/oauth/callback/
INSTAGRAM_SCOPE=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights,instagram_business_manage_comments
# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token (optional, used by check_instagram)

# Token Encryption (Fernet key)
TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SITE_URL=http://127.0.0.1:8000

# Prize Milestones (views)
PRIZE_MILESTONES=500,1000,5000,10000,50000,100000

# Instagram Rejimi (real: haqiqiy Instagram, mock: soxta simulyatsiya)
INSTAGRAM_MODE=real



